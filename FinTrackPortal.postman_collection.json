{
	"info": {
		"name": "FinTrackPortal API",
		"description": "FinTrack / FinShare — all API modules.\n\n1. Import **FinTrackPortal.postman_environment_Local.json** or **FinTrackPortal.postman_environment_Production.json**.\n2. Select that environment (top right).\n3. Set **loginEmail** and **loginPassword** in the environment.\n4. Run **Auth → Login** once (saves **token** and **memberId** to collection variables).\n5. Set **groupId** / **expenseId** / **secondMemberId** in collection variables if needed.\n\n**Upload attachment:** form-data field name must be **file** (choose jpg/png/pdf).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:7124"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "memberId",
			"value": ""
		},
		{
			"key": "email",
			"value": ""
		},
		{
			"key": "groupId",
			"value": ""
		},
		{
			"key": "expenseId",
			"value": ""
		},
		{
			"key": "lastMemberId",
			"value": ""
		},
		{
			"key": "secondMemberId",
			"value": "2"
		},
		{
			"key": "accountId",
			"value": "1"
		},
		{
			"key": "attachmentId",
			"value": "1"
		},
		{
			"key": "planId",
			"value": "2"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var j = pm.response.json();",
									"if (j.success && j.data && j.data.token) {",
									"    pm.collectionVariables.set('token', j.data.token);",
									"    pm.collectionVariables.set('memberId', String(j.data.memberId));",
									"    if (j.data.email) pm.collectionVariables.set('email', j.data.email);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"{{loginEmail}}\",\n    \"password\": \"{{loginPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Auth", "login"]
						},
						"description": "Login — token and memberId saved to collection variables."
					},
					"response": []
				},
				{
					"name": "Login - Invalid Password",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"abhilash@sysdatacenter.com\",\n    \"password\": \"wrong_password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Auth", "login"]
						},
						"description": "Test: Should return 401 with error message"
					},
					"response": []
				},
				{
					"name": "Login - Empty Fields",
