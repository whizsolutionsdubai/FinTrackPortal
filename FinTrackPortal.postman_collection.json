		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"try {",
									"    var response = pm.response.json();",
									"    console.log('Login Response:', JSON.stringify(response));",
									"",
									"    if (response.success && response.data && response.data.token) {",
									"        pm.collectionVariables.set('token', response.data.token);",
									"        pm.collectionVariables.set('memberId', String(response.data.memberId));",
									"        pm.collectionVariables.set('email', response.data.email);",
									"        console.log('Token saved successfully!');",
									"        console.log('MemberId: ' + response.data.memberId);",
									"        console.log('Email: ' + response.data.email);",
									"    } else {",
									"        console.log('Login failed: ' + response.message);",
									"    }",
									"",
									"    pm.test('Login successful', function () {",
									"        pm.response.to.have.status(200);",
									"        pm.expect(response.success).to.be.true;",
									"        pm.expect(response.data.token).to.be.a('string');",
									"    });",
									"} catch(e) {",
									"    console.log('Error parsing response: ' + e.message);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"abhilash@sysdatacenter.com\",\n    \"password\": \"sys\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login and get JWT token. Token is auto-saved to collection variables."
					},
					"response": []
				},
