	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:7124"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "memberId",
			"value": ""
		},
		{
			"key": "email",
			"value": ""
		},
		{
			"key": "groupId",
			"value": ""
		},
		{
			"key": "expenseId",
			"value": ""
