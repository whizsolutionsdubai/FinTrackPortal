{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_IN_ENVIRONMENT_CONFIG"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "REPLACE_IN_ENVIRONMENT_CONFIG",
    "Issuer": "FinShare",
    "Audience": "FinShareUsers",
    "ExpiryMinutes": 60
  },
  "AttachmentStorage": {
    "Provider": "Azure"
  },
  "AzureStorage": {
    "ConnectionString": "REPLACE_IN_ENVIRONMENT_CONFIG",
    "ContainerName": "attachments"
  },
  "LocalStorage": {
    "Path": "App_Data/attachments",
    "PublicBaseUrl": "REPLACE_WITH_https://your-host/attachments"
  },
  "Email": {
    "Enabled": false,
    "Provider": "MicrosoftGraph",
    "FromName": "FinShare",
    "FromEmail": "noreply@YOUR_DOMAIN.onmicrosoft.com",
    "AppPublicUrl": "https://finshare.me",
    "Graph": {
      "TenantId": "YOUR_DIRECTORY_TENANT_ID_GUID",
      "ClientId": "YOUR_APP_REGISTRATION_APPLICATION_CLIENT_ID",
      "ClientSecret": "REPLACE_USE_USER_SECRETS_OR_KEY_VAULT",
      "SenderMailbox": "noreply@YOUR_DOMAIN.onmicrosoft.com"
    },
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUser": "",
    "SmtpPassword": ""
  },
  "AllowedHosts": "*"
}
