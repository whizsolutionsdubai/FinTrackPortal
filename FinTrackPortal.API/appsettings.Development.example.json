{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YOUR_SERVER;Initial Catalog=FinTrackDB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;"
  },
  "AttachmentStorage": {
    "Provider": "Local"
  },
  "LocalStorage": {
    "Path": "App_Data/attachments",
    "PublicBaseUrl": "https://localhost:PORT/attachments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "USE_A_LONG_RANDOM_DEV_KEY_AT_LEAST_32_CHARS",
    "Issuer": "FinShare",
    "Audience": "FinShareUsers",
    "ExpiryMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Email": {
    "Enabled": false,
    "Provider": "MicrosoftGraph",
    "FromName": "FinShare",
    "FromEmail": "noreply@YOUR_TENANT.onmicrosoft.com",
    "AppPublicUrl": "https://localhost:PORT",
    "Graph": {
      "TenantId": "YOUR_DIRECTORY_TENANT_ID_GUID",
      "ClientId": "YOUR_APP_REGISTRATION_APPLICATION_CLIENT_ID",
      "ClientSecret": "USE_dotnet_user-secrets_OR_ENV_SEE_Docs_Email-Microsoft365-Setup.md",
      "SenderMailbox": "noreply@YOUR_TENANT.onmicrosoft.com"
    },
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUser": "",
    "SmtpPassword": ""
  }
}
